---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
import HomeIntro from '@/components/ui/HomeIntro.astro';
import GrainSection from '@/components/layouts/GrainSection.astro';
import { getHomeSchools, hasFeaturedProm } from '@/components/lib/content';
import type { HomeSchool } from '@/components/lib/types';
import LastWork from '@/components/ui/LastWork.astro';
import UnderlinedButton from '@/components/ui/UnderlinedButton.astro';
import YellowButton from '@/components/ui/YellowButton.astro';
import CTA from '@/components/sections/CTA.astro';
import IG from '@/components/sections/IG.astro';
import { toAbsoluteUrl } from '@/components/lib/seo';
import { animationSettings } from '@/components/lib/animation-settings';

const schools = await getHomeSchools();

const centeredTrustSlugs = new Set(['americano', 'interamerican']);
const centeredTrustSchools = schools.filter((school) =>
  centeredTrustSlugs.has(school.slug),
);
const otherTrustSchools = schools.filter(
  (school) => !centeredTrustSlugs.has(school.slug),
);
const trustCenterIndex = Math.ceil(otherTrustSchools.length / 2);
const trustCarouselSchools = [
  ...otherTrustSchools.slice(0, trustCenterIndex),
  ...centeredTrustSchools,
  ...otherTrustSchools.slice(trustCenterIndex),
];

const MAX_LAST_WORKS = 3;

const isAmericanoSchool = (school: HomeSchool) => {
  const normalizedValues = `${school.slug} ${school.name}`.toLowerCase();
  return normalizedValues.includes('americano');
};

const sortedSchools = schools
  .filter(hasFeaturedProm)
  .sort((a, b) => b.prom.id - a.prom.id);
const americanoSchool = sortedSchools.find(isAmericanoSchool);

let latestWorks = sortedSchools.slice(0, MAX_LAST_WORKS);

if (
  americanoSchool &&
  !latestWorks.some((school) => school.slug === americanoSchool.slug)
) {
  latestWorks = [
    ...latestWorks.slice(0, MAX_LAST_WORKS - 1),
    americanoSchool,
  ].sort((a, b) => b.prom.id - a.prom.id);
}

const pageTitle = 'Filmo | Cobertura de fotos y videos para colegios';
const pageDescription =
  'Filmo ofrece cobertura profesional de fotos y videos para colegios y promociones estudiantiles en Ecuador.';

const schemaHome = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Filmo',
  url: toAbsoluteUrl('/'),
  logo: toAbsoluteUrl('/og/filmo-og.png'),
  description: pageDescription,
  sameAs: ['https://www.instagram.com/filmo.inc'],
};

const schemaWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Filmo',
  url: toAbsoluteUrl('/'),
  inLanguage: 'es-EC',
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  ogImage="/og/filmo-og.png"
  jsonLd={[schemaHome, schemaWebsite]}
>
  {animationSettings.homeIntro && <script is:inline slot="head">
    // Arm before first paint; fail open if the animation module cannot load.
    if (window.__filmoFirstVisit && !location.hash && window.scrollY < 12) {
      document.documentElement.classList.add('home-intro-pending');
      window.setTimeout(() => document.documentElement.classList.remove('home-intro-pending'), 4500);
    }
  </script>}
  {animationSettings.homeIntro && <HomeIntro />}
  <section data-home-hero class="relative min-h-svh overflow-clip">
    <video
      class="hero-media home-hero-parallax brightness-50 md:brightness-60"
      data-home-hero-parallax
      autoplay
      muted
      loop
      preload="metadata"
      poster="/img/hero-poster.webp"
      playsinline>
        <source src="/video/hero.webm" type="video/webm">
        <source src="/video/hero.mp4" type="video/mp4">
    </video>

    <div
      class="pointer-events-none absolute inset-0 -z-10 hero-overlay-gradient"
      aria-hidden="true"
    >
    </div>

    <div class="hero-overlay-soft" aria-hidden="true"></div>

    <div
      class="site-container home-hero-content-parallax relative z-10 flex min-h-[87vh] pb-24 items-end justify-center"
      data-home-hero-parallax-content
    >
      <div
        class="text-center flex flex-col gap-8 items-center justify-center w-full lg:max-w-10/12"
      >
        <h1 data-hero-reveal class="text-balance lg:text-pretty text-6xl md:text-8xl">
          <span class="lg:block">Especialistas en</span>
          <span class="lg:block">capturar historias únicas</span>
        </h1>
        <p data-hero-reveal class="max-w-3/4 md:text-xl font-figtree font-medium md:max-w-5/12">
          Cada sonrisa, abrazo y logro merece ser eterno. Déjanos contar tu
          historia en imágenes.
        </p>
        <div data-hero-reveal>
          <YellowButton href="/portafolio" text="Conoce nuestro trabajo" />
        </div>
      </div>
    </div>
  </section>
  <script>
    const hero = document.querySelector<HTMLElement>('[data-home-hero]');
    const heroMedia = document.querySelector<HTMLElement>('[data-home-hero-parallax]');
    const heroContent = document.querySelector<HTMLElement>('[data-home-hero-parallax-content]');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let parallaxFrame = 0;

    const updateHeroParallax = () => {
      parallaxFrame = 0;
      if (!hero || !heroMedia) return;
      if (reducedMotion.matches) {
        heroMedia.style.transform = '';
        heroContent?.style.removeProperty('transform');
        return;
      }
      const progress = Math.min(Math.max(-hero.getBoundingClientRect().top / hero.offsetHeight, 0), 1);
      heroMedia.style.transform = `translate3d(0, ${progress * 58}%, 0) scale(1.16)`;
      if (heroContent) heroContent.style.transform = `translate3d(0, ${progress * 36}%, 0)`;
    };

    const requestHeroParallax = () => {
      if (!parallaxFrame) parallaxFrame = requestAnimationFrame(updateHeroParallax);
    };

    window.addEventListener('scroll', requestHeroParallax, { passive: true });
    window.addEventListener('resize', requestHeroParallax, { passive: true });
    reducedMotion.addEventListener('change', requestHeroParallax);
    requestHeroParallax();
  </script>
  <style>
    .home-hero-parallax { transform: scale(1.16); will-change: transform; }
    .home-hero-content-parallax { will-change: transform; }
    @media (prefers-reduced-motion: reduce) {
      .home-hero-parallax { transform: none; }
      .home-hero-content-parallax { transform: none; }
    }
  </style>
  <GrainSection>
    <div class="site-container flex flex-col items-center gap-16">
      <h2 class="text-lg text-filmo-gray font-figtree font-medium uppercase">
        Hemos trabajado con
      </h2>
      <div
        class="trust-carousel w-full overflow-hidden"
        aria-label={`Colegios que han trabajado con Filmo: ${schools.map((school) => school.name).join(', ')}`}
        role="region"
      >
        <div class="trust-carousel-track" aria-hidden="true">
          <div class="trust-carousel-group">
            {
              trustCarouselSchools.map((school) => (
                <div class="flex shrink-0 items-center justify-center px-6 lg:px-10">
                  <img
                    class="h-18 lg:h-26 w-auto max-w-90 object-contain brightness-125"
                    src={school.logos.grayscale}
                    alt=""
                    loading="lazy"
                    fetchpriority="low"
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
          <div class="trust-carousel-group">
            {
              trustCarouselSchools.map((school) => (
                <div class="flex shrink-0 items-center justify-center px-6 lg:px-10">
                  <img
                    class="h-18 lg:h-26 w-auto max-w-90 object-contain brightness-125"
                    src={school.logos.grayscale}
                    alt=""
                    loading="lazy"
                    fetchpriority="low"
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </GrainSection>
  <GrainSection>
    <div data-about-layout class="hidden sm:flex site-container flex-row">
      <div class="w-7/12 flex flex-col items-start gap-24">
        <div class="w-6/7 flex flex-col gap-24">
          <div data-about-reveal class="flex flex-col items-center text-center gap-9">
            <div class="flex flex-col gap-3 items-center">
              <span class="text-filmo-gray uppercase font-medium"
                >Como si fuera ese día otra vez</span
              >
              <h2 class="text-5xl text-center text-pretty">
                <span class="block">Cobertura audiovisual para</span>
                <span class="block">esos momentos estudiantiles</span>
                <span class="block">que no se repiten.</span>
              </h2>
            </div>
            <UnderlinedButton href="/portafolio" text="conoce más" />
          </div>
          <img
            src="/img/about2.webp"
            class="w-full aspect-video rounded-xl object-cover"
            alt=""
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />
        </div>
        <div class="w-6/7 self-end flex flex-col gap-10">
          <img
            src="/img/f4.png"
            class="rounded-t-full"
            alt=""
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />
        </div>
      </div>
      <div class="w-5/12 flex flex-col gap-32">
        <div class="w-auto flex flex-col gap-9">
          <div class="w-4/5 self-start">
            <img
              src="/img/about1.webp"
              class="w-full rounded-xl"
              alt=""
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div data-about-reveal class="w-full flex flex-col gap-6">
            <h2 class="text-5xl uppercase leading-[100%] text-right">
              <span class="2xl:block">Vives y disfrutas al</span>
              <span class="2xl:block">máximo, se nota en</span>
              <span class="2xl:block">cada momento.</span>
            </h2>
            <p class="self-end text-pretty text-right font-medium text-white">
              <span class=lg:block"
                >Cuando celebras tu graduación, compartes risas y buenas vibras</span
              >
              <span class=lg:block">
                en tu fiesta, lo que importa son las experiencias que creas</span
              >
              <span class=lg:block">
                con las personas que hacen que tu historia sea especial.</span
              >
            </p>
            <UnderlinedButton
              href="#lastWork"
              text="Nuestro último trabajo"
              cls="w-fit self-end"
            />
          </div>
        </div>
        <img
          src="/img/about5.webp"
          class="w-4/5 self-end rounded-xl"
          alt=""
          loading="lazy"
          fetchpriority="low"
          decoding="async"
        />
      </div>
    </div>

    <div data-about-layout class="pt-5 pb-10 flex sm:hidden site-container flex-col gap-2">
      <div data-about-reveal class="w-full translate-y-10 flex flex-col items-start text-left gap-6">
        <div class="flex flex-col gap-3 items-start">
          <span class="text-filmo-gray text-sm uppercase font-medium"
            >Como si fuera ese día otra vez</span
          >
          <h2 class="text-4xl text-balance text-left leading-[100%]">
            <span class="">Cobertura audiovisual </span>
            <span class="">para esos momentos </span>
            <span class="">estudiantiles que no se repiten.</span>
          </h2>
        </div>
        <UnderlinedButton href="/portafolio" text="conoce más" />
      </div>
      <div class="mt-3 mb-5 flex items-center overflow-x-auto gap-4 pb-3">
        <img
          class="h-auto w-70 object-cover rounded-xl"
          src="/img/about2.webp"
          alt=""
          loading="lazy"
          fetchpriority="low"
          decoding="async"
        />
        <img
          class="h-auto w-50 object-cover rounded-xl"
          src="/img/about1.webp"
          alt=""
          loading="lazy"
          fetchpriority="low"
          decoding="async"
        />
      </div>
      <div data-about-reveal class="mb-8 w-full flex flex-col gap-6">
        <div class="flex flex-col items-end gap-2">
          <h2 class="text-3xl uppercase text-right">
            <span class="">Vives y disfrutas al</span>
            <span class="">máximo, se nota en</span>
            <span class="">cada momento.</span>
          </h2>
          <p class="self-end w-[95%] text-balance text-right font-thin text-white">
            Cuando celebras tu graduación, compartes risas y buenas vibras
            en tu fiesta, lo que importa son las experiencias que celebras
            con las personas que hacen que tu historia sea especial.
          </p>
        </div>

        <UnderlinedButton
          href="#lastWork"
          text="Nuestro último trabajo"
          cls="w-fit self-end"
        />
      </div>
      <img
        src="/img/about5.webp"
        class="rounded-xl"
        alt=""
        loading="lazy"
        fetchpriority="low"
        decoding="async"
      >
    </div>
  </GrainSection>
  <GrainSection>
    <div class="site-container flex flex-col items-center gap-12" id="lastWork">
      <div class="flex flex-col gap-12 items-center">
        <h2 class="text-7xl lg:w-4/11 lg:text-8xl leading-[80%] flex flex-col">
          <span>Nuestro</span>
          <span class="ml-10">Portafolio</span>
        </h2>
        <div class="w-full">
          {
            latestWorks.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-8">
                {latestWorks.map((school) => (
                  <LastWork
                    school={school.name}
                    img={school.prom.cover}
                    prom={school.prom.id}
                    slug={`${school.slug}/${school.prom.id}`}
                  />
                ))}
              </div>
            ) : (
              <p class="text-center text-filmo-gray">
                No hay trabajos recientes disponibles.
              </p>
            )
          }
        </div>
      </div>
      <YellowButton href="/portafolio" text="Ver todo nuestro trabajo" />
    </div>
  </GrainSection>
  <CTA />
  <IG />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { CustomEase } from 'gsap/CustomEase';

  gsap.registerPlugin(CustomEase);
  CustomEase.create('about-reveal', '0.23, 1, 0.32, 1');
  const motion = gsap.matchMedia();

  motion.add({
    desktop: '(min-width: 640px)',
    mobile: '(max-width: 639px)',
    reduced: '(prefers-reduced-motion: reduce)',
  }, (context) => {
    const { desktop, reduced } = context.conditions!;
    const layout = document.querySelectorAll<HTMLElement>('[data-about-layout]')[desktop ? 0 : 1];
    if (!layout) return;
    const blocks = layout.querySelectorAll<HTMLElement>('[data-about-reveal], img');
    const running = new Map<HTMLElement, gsap.core.Tween>();
    const tweens: gsap.core.Tween[] = [];
    const seen = new Set<HTMLElement>();
    const getTargets = (block: HTMLElement) => block.tagName === 'IMG' ? [block] : Array.from(block.children);
    // Hide before observation; keep layout geometry intact for the trigger.
    gsap.set(Array.from(blocks).flatMap(getTargets), { opacity: 0 });

    const observer = new IntersectionObserver((entries) => {
      entries.filter((entry) => entry.isIntersecting).forEach((entry, order) => {
        const block = entry.target as HTMLElement;
        observer.unobserve(block);
        if (seen.has(block)) return;
        seen.add(block);
        const photo = block.tagName === 'IMG';
        const index = Array.from(blocks).indexOf(block);
        // Animate text children, preserving the mobile block's existing offset.
        const targets = getTargets(block);
        const tween = gsap.fromTo(targets, {
          opacity: 0,
          y: reduced ? 0 : photo ? (desktop ? 64 : 40) : 32,
          rotation: reduced || !photo ? 0 : (index % 2 ? 5 : -5),
          scale: reduced || !photo ? 1 : 0.9,
        }, {
          opacity: 1,
          y: 0,
          rotation: 0,
          scale: 1,
          duration: reduced ? 0.2 : photo ? 1.1 : 0.85,
          delay: reduced ? 0 : Math.min(order, 3) * 0.08,
          stagger: reduced ? 0 : 0.08,
          ease: 'about-reveal',
          onComplete: () => running.delete(block),
        });
        running.set(block, tween);
        tweens.push(tween);
      });
    }, {
      // Trigger inside the viewport, not as soon as an edge touches the screen.
      // Pixels keep this margin relative to viewport height on mobile as well.
      rootMargin: `0px 0px -${Math.round(window.innerHeight * 0.25)}px 0px`,
      threshold: 0,
    });

    blocks.forEach((block) => observer.observe(block));
    const onFocus = (event: FocusEvent) => {
      if (!(event.target instanceof Element)) return;
      const block = event.target.closest<HTMLElement>('[data-about-reveal]');
      if (!block || !layout.contains(block)) return;
      seen.add(block);
      observer.unobserve(block);
      running.get(block)?.progress(1);
      gsap.set(getTargets(block), { opacity: 1 });
    };
    layout.addEventListener('focusin', onFocus);
    return () => {
      observer.disconnect();
      layout.removeEventListener('focusin', onFocus);
      tweens.forEach((tween) => tween.revert());
      running.clear();
    };
  });
</script>

<style>
  .trust-carousel {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .trust-carousel-track {
    display: flex;
    width: max-content;
    animation: trust-carousel-scroll 25s linear infinite;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    will-change: transform;
  }

  .trust-carousel-group {
    display: flex;
    width: max-content;
    flex-shrink: 0;
    align-items: center;
  }

  .trust-carousel-group img {
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  @keyframes trust-carousel-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-carousel {
      mask-image: none;
    }

    .trust-carousel-track {
      width: 100%;
      animation: none;
    }

    .trust-carousel-group {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .trust-carousel-group + .trust-carousel-group {
      display: none;
    }
  }
</style>
