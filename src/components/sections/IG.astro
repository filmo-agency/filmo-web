---
import YellowButton from '../ui/YellowButton.astro';
import GrainSection from '../layouts/GrainSection.astro';

interface InstagramPost {
  id?: string;
  mediaType?: string;
  media_type?: string;
  mediaUrl?: string;
  media_url?: string;
  thumbnailUrl?: string;
  thumbnail_url?: string;
  permalink?: string;
}

const rawStrapiBaseUrl = (import.meta.env.PUBLIC_STRAPI_URL ?? '')
  .trim()
  .replace(/^['"]|['"]$/g, '');

function resolveStrapiBaseUrl(baseUrl: string): string {
  if (!baseUrl) return '';
  if (/^https?:\/\//i.test(baseUrl)) return baseUrl;
  if (/^(localhost|127\.0\.0\.1|0\.0\.0\.0)(:\d+)?(\/|$)/i.test(baseUrl))
    return `http://${baseUrl}`;
  return `https://${baseUrl}`;
}

function normalizePosts(payload: unknown): InstagramPost[] {
  if (Array.isArray(payload)) return payload as InstagramPost[];
  if (
    payload &&
    typeof payload === 'object' &&
    Array.isArray((payload as { data?: unknown[] }).data)
  ) {
    return (payload as { data: InstagramPost[] }).data;
  }
  return [];
}

function getPreviewUrl(post: InstagramPost): string {
  const mediaType = post.mediaType || post.media_type;
  const mediaUrl = post.mediaUrl || post.media_url || '';
  const thumbnailUrl = post.thumbnailUrl || post.thumbnail_url || '';
  if (mediaType === 'VIDEO' && thumbnailUrl) return thumbnailUrl;
  return mediaUrl;
}

function getPostIconSrc(post: InstagramPost): string {
  const mediaType = post.mediaType || post.media_type;
  if (mediaType === 'VIDEO') {
    return '<svg aria-label="Clip" fill="#fff" height="20" role="img" viewBox="0 0 24 24" width="20"><path d="M22.942 7.464c-.062-1.36-.306-2.143-.511-2.671a5.366 5.366 0 0 0-1.272-1.952 5.364 5.364 0 0 0-1.951-1.27c-.53-.207-1.312-.45-2.673-.513-1.2-.054-1.557-.066-4.535-.066s-3.336.012-4.536.066c-1.36.062-2.143.306-2.672.511-.769.3-1.371.692-1.951 1.272s-.973 1.182-1.27 1.951c-.207.53-.45 1.312-.513 2.673C1.004 8.665.992 9.022.992 12s.012 3.336.066 4.536c.062 1.36.306 2.143.511 2.671.298.77.69 1.373 1.272 1.952.58.581 1.182.974 1.951 1.27.53.207 1.311.45 2.673.513 1.199.054 1.557.066 4.535.066s3.336-.012 4.536-.066c1.36-.062 2.143-.306 2.671-.511a5.368 5.368 0 0 0 1.953-1.273c.58-.58.972-1.181 1.27-1.95.206-.53.45-1.312.512-2.673.054-1.2.066-1.557.066-4.535s-.012-3.336-.066-4.536Zm-7.085 6.055-5.25 3c-1.167.667-2.619-.175-2.619-1.519V9c0-1.344 1.452-2.186 2.619-1.52l5.25 3c1.175.672 1.175 2.368 0 3.04Z"></path></svg>';
  }
  if (mediaType === 'CAROUSEL_ALBUM') {
    return '<svg aria-label="Secuencia" fill="#fff" height="20" role="img" viewBox="0 0 48 48" width="20"><path d="M34.8 29.7V11c0-2.9-2.3-5.2-5.2-5.2H11c-2.9 0-5.2 2.3-5.2 5.2v18.7c0 2.9 2.3 5.2 5.2 5.2h18.7c2.8-.1 5.1-2.4 5.1-5.2zM39.2 15v16.1c0 4.5-3.7 8.2-8.2 8.2H14.9c-.6 0-.9.7-.5 1.1 1 1.1 2.4 1.8 4.1 1.8h13.4c5.7 0 10.3-4.6 10.3-10.3V18.5c0-1.6-.7-3.1-1.8-4.1-.5-.4-1.2 0-1.2.6z"></path></svg>';
  }
  return '';
}

const strapiBaseUrl = resolveStrapiBaseUrl(rawStrapiBaseUrl);
const endpoint = strapiBaseUrl
  ? new URL('/api/ig', strapiBaseUrl).toString()
  : '';
const clientEndpoint = import.meta.env.PROD ? '/api/ig' : endpoint;

let initialPosts: InstagramPost[] = [];
let initialError = '';

if (!endpoint) {
  initialError = 'No se configuró PUBLIC_STRAPI_URL.';
} else {
  try {
    const response = await fetch(endpoint, { cache: 'no-store' });
    if (!response.ok) {
      initialError = `No se pudo cargar Instagram (${response.status}).`;
    } else {
      initialPosts = normalizePosts(await response.json()).slice(0, 3);
      if (initialPosts.length === 0) initialError = 'No hay posts disponibles.';
    }
  } catch {
    initialError = 'No se pudieron cargar los posts de Instagram.';
  }
}
---

<GrainSection contentClass="overflow-x-clip">
  <div
    class="site-container flex flex-col pt-20 gap-10 lg:gap-20 lg:h-fit lg:flex-row lg:items-center lg:justify-between"
    data-ig-endpoint={clientEndpoint}
    id="ig-feed"
  >
    <div
      class="flex flex-col lg:items-start items-center text-center lg:text-left gap-4 lg:gap-11 lg:w-4/12 lg:shrink-0"
    >
      <div class="flex flex-col lg:gap-2">
        <span class="text-filmo-gray font-medium uppercase font-figtree"
          >instagram</span
        >

        <h2 class="text-4xl lg:text-6xl">
          <span class="block">Sigue de cerca</span>
          <span class="block">nuestro trabajo</span>
        </h2>
      </div>
      <YellowButton
        text="Ir a instagram"
        iconSize={20}
        href="https://instagram.com/filmo.inc"
        cls="w-fit"
        blank={true}
        ig={true}
      />
    </div>

    <div class="lg:mr-[calc(50%-55vw)] h-full lg:overflow-x-clip">
      <div
        id="ig-grid"
        class="flex gap-4 h-full overflow-x-auto pb-2 snap-x snap-mandatory lg:gap-6 lg:overflow-visible"
      >
        {
          initialPosts.length > 0 ? (
            initialPosts.map((post) => (
              <a
                href={post.permalink || '#'}
                target="_blank"
                rel="noopener noreferrer"
                class="relative group flex rounded-xl overflow-clip shrink-0 snap-start h-80 w-60 lg:h-100 lg:w-80 hover:-translate-y-2 transition-all duration-300"
              >
                {getPostIconSrc(post) && (
                  <span
                    class="absolute top-3 right-3 z-10"
                    set:html={getPostIconSrc(post)}
                  />
                )}
                <img
                  src={getPreviewUrl(post)}
                  alt="Post de Instagram"
                  class="h-full w-full object-cover transition-transform duration-300 "
                  loading="lazy"
                  fetchpriority="low"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              </a>
            ))
          ) : (
            <p class="text-filmo-gray">{initialError || 'Cargando posts...'}</p>
          )
        }
      </div>
    </div>
  </div>
</GrainSection>

<script>
  const videoIconSvg =
    '<svg aria-label="Clip" fill="#fff" height="20" role="img" viewBox="0 0 24 24" width="20"><path d="M22.942 7.464c-.062-1.36-.306-2.143-.511-2.671a5.366 5.366 0 0 0-1.272-1.952 5.364 5.364 0 0 0-1.951-1.27c-.53-.207-1.312-.45-2.673-.513-1.2-.054-1.557-.066-4.535-.066s-3.336.012-4.536.066c-1.36.062-2.143.306-2.672.511-.769.3-1.371.692-1.951 1.272s-.973 1.182-1.27 1.951c-.207.53-.45 1.312-.513 2.673C1.004 8.665.992 9.022.992 12s.012 3.336.066 4.536c.062 1.36.306 2.143.511 2.671.298.77.69 1.373 1.272 1.952.58.581 1.182.974 1.951 1.27.53.207 1.311.45 2.673.513 1.199.054 1.557.066 4.535.066s3.336-.012 4.536-.066c1.36-.062 2.143-.306 2.671-.511a5.368 5.368 0 0 0 1.953-1.273c.58-.58.972-1.181 1.27-1.95.206-.53.45-1.312.512-2.673.054-1.2.066-1.557.066-4.535s-.012-3.336-.066-4.536Zm-7.085 6.055-5.25 3c-1.167.667-2.619-.175-2.619-1.519V9c0-1.344 1.452-2.186 2.619-1.52l5.25 3c1.175.672 1.175 2.368 0 3.04Z"></path></svg>';
  const carouselIconSvg =
    '<svg aria-label="Secuencia" fill="#fff" height="20" role="img" viewBox="0 0 48 48" width="20"><path d="M34.8 29.7V11c0-2.9-2.3-5.2-5.2-5.2H11c-2.9 0-5.2 2.3-5.2 5.2v18.7c0 2.9 2.3 5.2 5.2 5.2h18.7c2.8-.1 5.1-2.4 5.1-5.2zM39.2 15v16.1c0 4.5-3.7 8.2-8.2 8.2H14.9c-.6 0-.9.7-.5 1.1 1 1.1 2.4 1.8 4.1 1.8h13.4c5.7 0 10.3-4.6 10.3-10.3V18.5c0-1.6-.7-3.1-1.8-4.1-.5-.4-1.2 0-1.2.6z"></path></svg>';

  const root = document.getElementById('ig-feed');
  const grid = document.getElementById('ig-grid');

  if (!root || !grid) {
    throw new Error('IG container not found');
  }

  const endpoint = root.getAttribute('data-ig-endpoint');
  if (!endpoint) {
    grid.innerHTML =
      '<p class="text-filmo-gray">No se configuró PUBLIC_STRAPI_URL.</p>';
  } else {
    fetch(endpoint)
      .then((res) => {
        if (!res.ok) throw new Error(`Failed with status ${res.status}`);
        return res.json();
      })
      .then((payload) => {
        const posts = Array.isArray(payload)
          ? payload
          : Array.isArray(payload?.data)
            ? payload.data
            : [];

        if (!Array.isArray(posts) || posts.length === 0) {
          return;
        }

        const cards = posts.slice(0, 3).map((post) => {
          const mediaType = post.mediaType || post.media_type;
          const mediaUrl = post.mediaUrl || post.media_url || '';
          const thumbnailUrl = post.thumbnailUrl || post.thumbnail_url || '';
          const permalink = post.permalink || '#';
          const previewUrl =
            mediaType === 'VIDEO' && thumbnailUrl ? thumbnailUrl : mediaUrl;
          const iconMarkup =
            mediaType === 'VIDEO'
              ? videoIconSvg
              : mediaType === 'CAROUSEL_ALBUM'
                ? carouselIconSvg
                : '';

          return `
            <a href="${permalink}" target="_blank" rel="noopener noreferrer" class="relative group block rounded-xl aspect-[3/4] overflow-clip shrink-0 w-[72vw] max-w-[18rem] snap-start lg:w-[18rem]">
              ${iconMarkup ? `<span class="absolute top-3 right-3 z-10">${iconMarkup}</span>` : ''}
              <img src="${previewUrl}" alt="Post de Instagram" class="h-full w-full object-cover transition-transform duration-300 " loading="lazy" fetchpriority="low" decoding="async" referrerpolicy="no-referrer" />
            </a>
          `;
        });

        grid.innerHTML = cards.join('');
      })
      .catch((error) => {
        console.error('IG client fetch error:', error);
      });
  }
</script>
