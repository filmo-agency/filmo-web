---
import YellowButton from './YellowButton.astro';
---

<header
  class="navbar-shell fixed top-0 left-0 z-20 isolate w-full bg-transparent transition-colors duration-300 [&.is-scrolled]:bg-filmo-black-100 [&.is-scrolled]:shadow-lg [&.is-scrolled]:shadow-neutral-950/25"
>
  <div
    class="grain-overlay opacity-0 transition-opacity duration-300 in-[.is-scrolled]:opacity-[.14]"
    aria-hidden="true"
  ></div>
  <nav
    class="relative z-10 flex items-center justify-between site-container px-6 py-5 transition-[padding] duration-300 lg:px-14 lg:py-7 in-[.is-scrolled]:py-3 lg:in-[.is-scrolled]:py-5"
  >
    <a href="/" class="">
      <img
        src="/svg/filmo.svg"
        class="h-10 lg:h-14 drop-shadow-nav w-auto transition-[height] duration-300 in-[.is-scrolled]:h-10 lg:in-[.is-scrolled]:h-13"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </a>
    <button
      type="button"
      class="menu-toggle relative z-30 flex h-10 w-10 items-center justify-center text-white lg:hidden"
      aria-label="Abrir menú de navegación"
      aria-controls="primary-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Abrir menú</span>
      <span class="relative block h-4 w-6">
        <span
          class="absolute left-0 top-0 block h-0.5 w-6 bg-white transition-all duration-300"
          data-line="top"
        ></span>
        <span
          class="absolute left-0 top-1.5 block h-0.5 w-6 bg-white transition-opacity duration-200"
          data-line="middle"
        ></span>
        <span
          class="absolute left-0 top-3 block h-0.5 w-6 bg-white transition-all duration-300"
          data-line="bottom"
        ></span>
      </span>
    </button>
    <ul
      id="primary-menu"
      class="mobile-menu absolute left-6 right-6 top-[calc(100%+0.5rem)] z-20 hidden flex-col gap-8 rounded-2xl border border-white/10 bg-filmo-black-100 p-4 shadow-filmo-soft lg:static lg:flex lg:w-auto lg:flex-row lg:items-center lg:gap-12 lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none lg:backdrop-blur-0"
    >
      <li class="text-lg text-white font-medium font-figtree">
        <a href="/">Inicio</a>
      </li>
      <li class="text-lg lg:ml-4 text-white font-medium font-figtree my-4 lg:my-0">
        <a href="/portafolio">Portafolio</a>
      </li>
      <li class="hidden lg:block"><YellowButton blank={true} iconSize={24} ws={true} text="contáctanos" href='https://wa.me/+593983903842' cls="px-4 py-3 text-center lg:w-auto" /></li>
      <li class="block lg:hidden text-lg text-white font-medium font-figtree"><a href="https://wa.me/+593983903842" target="_blank">Contacto</a></li>
    </ul>
  </nav>
</header>

<script>
  const nav = document.querySelector('.navbar-shell');
  const menuToggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#primary-menu');
  const menuLinks = menu?.querySelectorAll('a') ?? [];

  const closeMenu = () => {
    if (!menuToggle || !menu) return;
    menu.classList.add('hidden');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Abrir menú de navegación');
    document.body.classList.remove('overflow-hidden');
    menuToggle.querySelector('[data-line="top"]')?.classList.remove('translate-y-1.5', 'rotate-45');
    menuToggle.querySelector('[data-line="middle"]')?.classList.remove('opacity-0');
    menuToggle.querySelector('[data-line="bottom"]')?.classList.remove('-translate-y-1.5', '-rotate-45');
  };

  const openMenu = () => {
    if (!menuToggle || !menu) return;
    menu.classList.remove('hidden');
    menuToggle.setAttribute('aria-expanded', 'true');
    menuToggle.setAttribute('aria-label', 'Cerrar menú de navegación');
    document.body.classList.add('overflow-hidden');
    menuToggle.querySelector('[data-line="top"]')?.classList.add('translate-y-1.5', 'rotate-45');
    menuToggle.querySelector('[data-line="middle"]')?.classList.add('opacity-0');
    menuToggle.querySelector('[data-line="bottom"]')?.classList.add('-translate-y-1.5', '-rotate-45');
  };

  const toggleMenu = () => {
    if (!menuToggle) return;
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMenu();
      return;
    }
    openMenu();
  };

  if (nav) {
    const toggleScrolledState = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 12);
    };

    toggleScrolledState();
    window.addEventListener('scroll', toggleScrolledState, { passive: true });
  }

  if (menuToggle) {
    menuToggle.addEventListener('click', toggleMenu);
    menuLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        closeMenu();
      }
    });
  }
</script>
