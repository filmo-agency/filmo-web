---
import type { PortfolioImage } from '@/components/lib/types';

interface Props {
  promPics: PortfolioImage[];
  seed?: string | number;
}

interface PicWithOrder extends PortfolioImage {
  __order: number;
}

const { promPics = [], seed = '' } = Astro.props as Props;

const stringToSeed = (value: string | number): number => {
  const input = String(value);
  let hash = 1779033703 ^ input.length;

  for (let index = 0; index < input.length; index += 1) {
    hash = Math.imul(hash ^ input.charCodeAt(index), 3432918353);
    hash = (hash << 13) | (hash >>> 19);
  }

  return (hash >>> 0) || 1;
};

const createRng = (initialSeed: number) => {
  let current = initialSeed;
  return () => {
    current |= 0;
    current = (current + 0x6d2b79f5) | 0;
    let t = Math.imul(current ^ (current >>> 15), 1 | current);
    t ^= t + Math.imul(t ^ (t >>> 7), 61 | t);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
};

const shuffleDeterministic = <T,>(items: T[], seedValue: string | number): T[] => {
  const shuffled = [...items];
  const random = createRng(stringToSeed(seedValue));

  for (let index = shuffled.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(random() * (index + 1));
    [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
  }

  return shuffled;
};

const splitIntoColumns = (pics: PicWithOrder[], columnCount: number): PicWithOrder[][] => {
  const columns: PicWithOrder[][] = Array.from({ length: columnCount }, () => []);
  const columnHeights = Array.from({ length: columnCount }, () => 0);

  for (const pic of pics) {
    const width = pic.width > 0 ? pic.width : 1;
    const height = pic.height > 0 ? pic.height : 1;
    const aspectRatio = height / width;
    const shortestColumnHeight = Math.min(...columnHeights);
    const shortestColumnIndex = columnHeights.indexOf(shortestColumnHeight);

    columns[shortestColumnIndex].push(pic);
    columnHeights[shortestColumnIndex] += aspectRatio;
  }

  return columns;
};

const orderedPics = shuffleDeterministic(promPics, `${seed}-${promPics.length}`)
  .map((pic, index) => ({ ...pic, __order: index }));

const desktopColumns = splitIntoColumns(orderedPics, 3);
const mobileColumns = splitIntoColumns(orderedPics, 2);
---

{
  orderedPics.length > 0 ? (
    <section class="flex w-full flex-col items-center gap-16" data-prom-collage>
      <div class="relative w-full">
        <div
          data-collage-content
          class="max-h-200 overflow-hidden transition-[max-height] duration-500 ease-out"
        >
          <div class="hidden w-full grid-cols-3 gap-4 md:grid">
            {desktopColumns.map((column, columnIndex) => (
              <div
                class:list={[
                  'flex flex-col gap-4',
                  columnIndex === 1 && 'md:translate-y-10',
                  columnIndex === 2 && 'md:translate-y-20',
                ]}
              >
                {column.map((pic) => {
                  const imageSrc = pic.url;
                  const imageAlt = `Foto de promoción ${pic.__order + 1}`;
                  const isPriorityImage = columnIndex === 0 && pic.__order < 2;

                  return (
                    <article class="overflow-hidden rounded-xl bg-filmo-black-80/70">
                      <img
                        src={imageSrc}
                        alt={imageAlt}
                        loading={isPriorityImage ? 'eager' : 'lazy'}
                        fetchpriority={isPriorityImage ? 'auto' : 'low'}
                        decoding="async"
                        width={pic.width}
                        height={pic.height}
                        class="block h-auto w-full object-cover shadow-filmo-soft"
                      />
                    </article>
                  );
                })}
              </div>
            ))}
          </div>

          <div class="grid w-full grid-cols-2 gap-2 md:hidden">
            {mobileColumns.map((column, columnIndex) => (
              <div class="flex flex-col gap-2">
                {column.map((pic) => {
                  const imageSrc = pic.url;
                  const imageAlt = `Foto de promoción ${pic.__order + 1}`;
                  const isPriorityImage = columnIndex === 0 && pic.__order < 2;

                  return (
                    <article class="overflow-hidden rounded-lg bg-filmo-black-80/70">
                      <img
                        src={imageSrc}
                        alt={imageAlt}
                        loading={isPriorityImage ? 'eager' : 'lazy'}
                        fetchpriority={isPriorityImage ? 'auto' : 'low'}
                        decoding="async"
                        width={pic.width}
                        height={pic.height}
                        class="block h-auto w-full object-cover shadow-filmo-soft"
                      />
                    </article>
                  );
                })}
              </div>
            ))}
          </div>

          <div
            data-collage-fade
            class="pointer-events-none absolute inset-x-0 bottom-0 h-36 bg-linear-to-t from-filmo-black-100 to-transparent"
          >
          </div>
        </div>
      </div>

      <button
        type="button"
        data-collage-toggle
        class="drop-shadow-button hidden rounded-full bg-filmo-yellow-100 px-7 py-3 font-figtree font-bold uppercase text-filmo-black-100 cursor-pointer"
      >
        Ver todas las fotos
      </button>

      <script is:inline>
        (() => {
          const root = document.currentScript?.closest('[data-prom-collage]');
          if (!root) return;

          const content = root.querySelector('[data-collage-content]');
          const fade = root.querySelector('[data-collage-fade]');
          const toggle = root.querySelector('[data-collage-toggle]');
          if (!content || !fade || !toggle) return;

          let expanded = false;
          const collapsedHeight = 800;

          const sync = () => {
            if (expanded) return;
            const needsCollapse = content.scrollHeight > collapsedHeight + 8;
            toggle.classList.toggle('hidden', !needsCollapse);
            fade.classList.toggle('hidden', !needsCollapse);

            if (!needsCollapse) {
              content.classList.remove('max-h-[800px]', 'overflow-hidden');
              content.classList.add('max-h-none', 'overflow-visible');
            }
          };

          toggle.addEventListener('click', () => {
            expanded = true;
            content.classList.remove('max-h-[800px]', 'overflow-hidden');
            content.classList.add('max-h-none', 'overflow-visible');
            fade.classList.add('hidden');
            toggle.classList.add('hidden');
          });

          sync();
          window.addEventListener('load', sync, { once: true });
        })();
      </script>
    </section>
  ) : (
    <p class="text-center text-filmo-gray">No hay fotos disponibles para esta promoción.</p>
  )
}
